# =============================================================================
# Bharath Masala Products — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# NEVER hardcode secrets in source code.
# =============================================================================

# ---------------------------------------------------------------------------
# Django Core
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://bmp_user:replace-with-strong-password@localhost:5432/bharath_masala

# ---------------------------------------------------------------------------
# Celery / Redis (Phase 3+)
# ---------------------------------------------------------------------------
# Broker: used by Celery workers to receive tasks
CELERY_BROKER_URL=redis://localhost:6379/0

# Result backend: used to store task results and monitor completion
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# JWT & Cookie Settings
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Domain for HttpOnly cookies (leave blank for localhost development)
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Rate Limiting (requests per minute)
# ---------------------------------------------------------------------------
THROTTLE_ANON_RATE=20/min
THROTTLE_USER_RATE=100/min
THROTTLE_AUTH_RATE=5/min

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# CORS (comma-separated allowed origins for production)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---------------------------------------------------------------------------
# Payment Gateway — Razorpay (Phase 3: payments)
# Obtain from Razorpay dashboard — NEVER hardcode in source code
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# ---------------------------------------------------------------------------
# Email (Phase 3: order confirmation emails)
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourmailprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-email-username
EMAIL_HOST_PASSWORD=replace-with-email-password
DEFAULT_FROM_EMAIL=Bharath Masala Products <noreply@bharathmasala.com>

# ---------------------------------------------------------------------------
# Statutory Indian GST Invoicing (Phase 3.8)
# ---------------------------------------------------------------------------
INVOICE_SELLER_NAME=Bharath Masala Products
INVOICE_SELLER_GSTIN=29AAAAA0000A1Z5
INVOICE_SELLER_FSSAI=11223344556677
INVOICE_SELLER_ADDRESS=Main Road, Thirthahalli, Shimoga District, Karnataka 577432

# ---------------------------------------------------------------------------
# Static & Media Storage (production)
# ---------------------------------------------------------------------------
# Uncomment and configure for cloud storage (e.g., AWS S3) in production
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-south-1

