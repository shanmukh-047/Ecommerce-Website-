# =============================================================================
# BHARATH MASALA PRODUCTS — PRODUCTION ENVIRONMENT CONFIGURATION
# File: .env.production.example
# =============================================================================
# Instructions:
# 1. Copy this template to .env or inject these variables in your Render Dashboard.
# 2. Generate a secure DJANGO_SECRET_KEY (min 50 characters).
# 3. Supply production PostgreSQL DATABASE_URL.
# 4. NEVER commit real credentials or secrets to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# 1. Django Production Core
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=False
# Generate via: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=replace-with-cryptographically-secure-string-at-least-50-chars
DJANGO_ALLOWED_HOSTS=bharathmasala.com,www.bharathmasala.com,.onrender.com,.koyeb.app,.vercel.app,localhost,127.0.0.1

# ---------------------------------------------------------------------------
# 2. Database (PostgreSQL 15+ Mandatory)
# ---------------------------------------------------------------------------
# Free Tier Option: Neon Serverless PostgreSQL (https://neon.tech) - 0.5 GB, 0 card needed
# Format: postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql://neondb_owner:replace-with-neon-password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# 3. Security, CORS & CSRF
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://bharathmasala.com,https://www.bharathmasala.com
CSRF_TRUSTED_ORIGINS=https://bharathmasala.com,https://www.bharathmasala.com,https://*.vercel.app,https://*.onrender.com
SECURE_SSL_REDIRECT=True

# ---------------------------------------------------------------------------
# 4. Frontend & Domain URLs
# ---------------------------------------------------------------------------
FRONTEND_BASE_URL=https://bharathmasala.com

# ---------------------------------------------------------------------------
# 5. SimpleJWT Authentication & Token Lifecycle
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Leave COOKIE_DOMAIN blank/unset so cookies bind to current serving domain/subdomain
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# 6. Payment Gateway — Razorpay
# ---------------------------------------------------------------------------
# Set ENABLE_RAZORPAY=True once live KYC is approved and keys are obtained.
# When False, the store operates in Cash on Delivery (COD) mode safely.
ENABLE_RAZORPAY=False
RAZORPAY_KEY_ID=rzp_live_replace_with_live_key
RAZORPAY_KEY_SECRET=replace_with_live_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_live_webhook_secret

# ---------------------------------------------------------------------------
# 7. Transactional Email & Password Recovery (SMTP)
# ---------------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=replace-with-smtp-api-key
DEFAULT_FROM_EMAIL=Bharath Masala <support@bharathmasala.com>
PASSWORD_RESET_TIMEOUT=3600

# ---------------------------------------------------------------------------
# 8. Celery & Redis Background Worker (Optional)
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://bharath-masala-redis:6379/0
CELERY_RESULT_BACKEND=redis://bharath-masala-redis:6379/1

# ---------------------------------------------------------------------------
# 9. Logging & Diagnostics
# ---------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
THROTTLE_ANON_RATE=20/min
THROTTLE_USER_RATE=100/min
THROTTLE_AUTH_RATE=5/min

# ---------------------------------------------------------------------------
# 10. Statutory Indian GST Invoicing Metadata
# ---------------------------------------------------------------------------
INVOICE_SELLER_NAME=Bharath Masala Products
INVOICE_SELLER_GSTIN=29AAAAA0000A1Z5
INVOICE_SELLER_FSSAI=11223344556677
INVOICE_SELLER_ADDRESS=Main Road, Thirthahalli, Shimoga District, Karnataka 577432
