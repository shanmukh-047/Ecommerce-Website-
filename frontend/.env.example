# ==============================================================================
# Bharat Masala Frontend — Environment Configuration Template
# ==============================================================================
# Copy this file to:
#   .env.local        -> For local development overrides
#   .env.development  -> For local development environment
#   .env.production   -> For staging / production environment
# ==============================================================================

# Public API Base URL
# - Development: http://127.0.0.1:8000
# - Production:  https://bharathmasala.com/api
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# API Version Prefix
# - Default: /api/v1
NEXT_PUBLIC_API_PREFIX=/api/v1

# Internal Server-Side Backend URL (Used by Next.js SSR & API Rewrites)
# - Development: http://127.0.0.1:8000
# - Production:  http://backend-service:8000 (Internal Kubernetes/Docker network address)
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Public Brand / Store Metadata (Optional)
NEXT_PUBLIC_SITE_NAME=Bharat Masala
NEXT_PUBLIC_SUPPORT_WHATSAPP=+919876543210

# Razorpay Client Public Key
# - Test Mode:       rzp_test_YourKeyHere
# - Production Mode: rzp_live_YourKeyHere
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
