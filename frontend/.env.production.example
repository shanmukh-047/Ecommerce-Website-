# ==============================================================================
# BHARATH MASALA FRONTEND — PRODUCTION ENVIRONMENT TEMPLATE
# File: frontend/.env.production.example
# ==============================================================================
# Target Domain: https://bharathmasala.com/
# ==============================================================================

# Node Environment
NODE_ENV=production

# Public API Gateway Base URL (Used for unified single-domain routing)
# In production, relative browser calls route via Next.js beforeFiles rewrites.
NEXT_PUBLIC_API_BASE_URL=https://bharathmasala.com/api
NEXT_PUBLIC_API_PREFIX=/api/v1

# Internal Server-Side Backend URL
# - On Render: Name of your backend web service (e.g. http://bharath-masala-api:8000 or https://bharath-masala-api.onrender.com)
BACKEND_INTERNAL_URL=https://bharath-masala-api.onrender.com

# Public Storefront Branding & Support
NEXT_PUBLIC_SITE_NAME=Bharath Masala
NEXT_PUBLIC_SUPPORT_WHATSAPP=+919876543210
NEXT_PUBLIC_SUPPORT_EMAIL=support@bharathmasala.com

# Razorpay Client Public Key (Optional for online payment mode)
# Must match backend RAZORPAY_KEY_ID when online payments are enabled
NEXT_PUBLIC_RAZORPAY_KEY_ID=
